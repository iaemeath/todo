{
  "extends": "stylelint-config-standard",
  "overrides": [
    {
      "files": ["**/*.vue"],
      "customSyntax": "postcss-html"
    }
  ],
  "rules": {
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["tailwind", "theme", "layer", "container"] }],
    "comment-no-empty": true,
    "no-duplicate-selectors": true,
    "declaration-block-no-duplicate-properties": true,
    "declaration-empty-line-before": "never",
    "media-feature-name-value-no-unknown": true,
    "keyframes-name-pattern": null,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["deep", "global", "slotted"] }],
    "function-no-unknown": [true, { "ignoreFunctions": ["theme"] }],
    "import-notation": null,
    "declaration-property-value-disallowed-list": {
      "/^padding/": ["/^\\d+px$/", "/^\\d+\\.\\d+rem$/"],
      "gap": ["/^\\d+px$/"],
      "/^border-radius/": ["/^(?!9999px)\\d+px$/"]
    }
  },
  "ignoreFiles": ["node_modules/**", "dist/**", "deploy/**"]
}
