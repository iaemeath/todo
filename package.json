{
  "name": "shiguang",
  "description": "拾光 — AI 驱动的日历待办应用，捡拾时光",
  "author": "iaemeath <iaemeath@163.com>",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "electron/main.bundle.cjs",
  "scripts": {
    "dev": "vite",
    "test": "tsx --test tests/*.test.ts",
    "build": "vue-tsc -b && vite build && node scripts/write-version.mjs",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "electron:dev": "npm run build && electron electron/main.js",
    "bundle-main": "node scripts/bundle-main.mjs",
    "electron:build": "npm run build && node scripts/bundle-main.mjs && electron-builder --win nsis"
  },
  "build": {
    "appId": "pub.ylh.shiguang",
    "productName": "拾光",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "拾光-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://weekly.rl.ylh.pub/updates/"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@mlc-ai/web-llm": "^0.2.84",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.4",
    "fuse.js": "^7.4.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.38",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5"
  }
}
